  "Lessons": [
    {
      "key": 1222911559,
      "name": "Python Getting Started",
      "pages": [
        {
          "key": -1413366113,
          "name": "Python Install",
          "elements": [
            {
              "key": 493133030,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": true,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 32,
                "text_content": "Python Install"
              }
            },
            {
              "key": -1758965907,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Many PCs and Macs will have python already installed."
              }
            },
            {
              "key": 250716870,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "To check if you have python installed on a Windows PC, search in the start bar for Python or run the following on the Command Line (cmd.exe):"
              }
            },
            {
              "key": -1136526849,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "C:\\Users\\Your Name\u003Epython --version",
                "lines_enabled": false
              }
            },
            {
              "key": 1236352932,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "To check if you have python installed on a Linux or Mac, then on linux open the command line or on Mac open the Terminal and type:"
              }
            },
            {
              "key": 825220417,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "python --version",
                "lines_enabled": false
              }
            },
            {
              "key": -1154961417,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "If you find that you do not have Python installed on your computer, then you can download it for free from the following website: \u003Ccolor=blue\u003E\u003Cu\u003Ehttps://www.python.org/\u003C/u\u003E\u003C/color\u003E"
              }
            },
            {
              "key": 2100431378,
              "type": 51721585,
              "content": {
                "ai_model": 1897049,
                "writter_effect": false,
                "page_context": false,
                "tts": false,
                "submit": false,
                "message_system": "",
                "message_user": ""
              }
            }
          ]
        },
        {
          "key": 214250597,
          "name": "Python Quickstart",
          "elements": [
            {
              "key": 168271990,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": true,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 32,
                "text_content": "Python Quickstart"
              }
            },
            {
              "key": 799095761,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Python is an interpreted programming language, this means that as a developer you write Python (.py) files in a text editor and then put those files into the python interpreter to be executed."
              }
            },
            {
              "key": 1945695379,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "The way to run a python file is like this on the command line:"
              }
            },
            {
              "key": 2013802434,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "C:\\Users\\Your Name\u003Epython helloworld.py",
                "lines_enabled": false
              }
            },
            {
              "key": -2015001967,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Where \u0022helloworld.py\u0022 is the name of your python file."
              }
            },
            {
              "key": 596380354,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Let\u0027s write our first Python file, called helloworld.py, which can be done in any text editor."
              }
            },
            {
              "key": -409693434,
              "type": 1254542888,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_title": "helloworld.py",
                "text_content": "print(\u0022Hello, World!\u0022)",
                "lines_enabled": false
              }
            },
            {
              "key": 1470822935,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Simple as that. Save your file. Open your command line, navigate to the directory where you saved your file, and run:"
              }
            },
            {
              "key": -327040213,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "C:\\Users\\Your Name\u003Epython helloworld.py",
                "lines_enabled": false
              }
            },
            {
              "key": -219758207,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "The output should read:"
              }
            },
            {
              "key": -476956073,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "Hello, World!",
                "lines_enabled": false
              }
            },
            {
              "key": 803590111,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Congratulations, you have written and executed your first Python program."
              }
            }
          ]
        }
      ]
    },
    {
      "key": -1475171846,
      "name": "Python Syntax",
      "pages": [
        {
          "key": -1493954,
          "name": "Execute Python Syntax",
          "elements": [
            {
              "key": -511927185,

                "bold_enabled": true,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 32,
                "text_content": "Execute Python Syntax"
              }
            },
            {
              "key": 558046421,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "As we learned in the previous page, Python syntax can be executed by writing directly in the Command Line:"
              }
            },
            {
              "key": 1531402621,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "\u003E\u003E\u003E print(\u0022Hello, World!\u0022)\r\nHello, World!",
                "lines_enabled": false
              }
            },
            {
              "key": -1960303154,
              "type": -428893296,
              "content": {
                "alignment_horizontal": 0,
                "color_hex": "#000000",
                "spacing": {
                  "left": 15,
                  "right": 15,
                  "top": 6,
                  "bottom": 6
                },
                "bold_enabled": false,
                "italic_enabled": false,
                "underline_enabled": false,
                "font_size": 18,
                "text_content": "Or by creating a python file on the server, using the .py file extension, and running it in the Command Line:"
              }
            },
            {
              "key": 1404507683,
              "type": 813157805,
              "content": {
                "spacing": {
                  "left": 6,
                  "right": 6,
                  "top": 6,
                  "bottom": 6
                },
                "text_content": "C:\\Users\\Your Name\u003Epython myfile.py",
                "lines_enabled": false
              }
            }
          ]
        }
      ]
    }
  ],

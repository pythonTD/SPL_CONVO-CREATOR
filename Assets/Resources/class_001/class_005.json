{"version":"2","key":1265783456,"name":"class_005","Lessons":[{"key":409688330,"name":"Python Getting Started","pages":[{"key":-1132956376,"name":"Python Install","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"Python Install","key":1981500016,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Many PCs and Macs will have python already installed.","key":-1719028980,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"To check if you have python installed on a Windows PC, search in the start bar for Python or run the following on the Command Line (cmd.exe):","key":-997816599,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"C:\\Users\\Your Name\u003Epython --version","lines_enabled":false,"key":-221718531,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"To check if you have python installed on a Linux or Mac, then on linux open the command line or on Mac open the Terminal and type:","key":-875790511,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"python --version","lines_enabled":false,"key":696169001,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"If you find that you do not have Python installed on your computer, then you can download it for free from the following website:\n\u003Ccolor=blue\u003E\u003Cu\u003Ehttps://www.python.org/\u003C/u\u003E\u003C/color\u003E","key":146996400,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Text element...","key":-290648529,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"","lines_enabled":false,"key":-412110329,"type":813157805},{"$type":"Element.GENERAL_CODE_SCRIPT","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"","text_title":"","lines_enabled":false,"key":1317935503,"type":1254542888},{"$type":"Element.GENERAL_LINE","spacing":{"left":15,"right":15,"top":6,"bottom":6},"color_hex":"#F2F2F2","height":3,"key":-30594524,"type":1267293381},{"$type":"Element.GENERAL_WARNING","spacing":{"left":20,"right":20,"top":6,"bottom":6},"color_hex_frame":"#E5D4C7","color_hex_text":"#C13B0C","text_content":"This is a preview of the warning element.","key":-169613919,"type":1255947363}]},{"key":1796007341,"name":"Python Quickstart","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"Python Quickstart","key":-132202368,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Python is an interpreted programming language, this means that as a developer you write Python (.py) files in a text editor and then put those files into the python interpreter to be executed.","key":2130783200,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Let\u0027s write our first Python file, called helloworld.py, which can be done in any text editor:","key":-259926173,"type":-428893296},{"$type":"Element.GENERAL_CODE_SCRIPT","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"print(\u0022Hello, World!\u0022)","text_title":"helloworld.py","lines_enabled":false,"key":2103003830,"type":1254542888},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Simple as that. Save your file. Open your command line, navigate to the directory where you saved your file, and run:","key":1962827196,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"C:\\Users\\Your Name\u003Epython helloworld.py","lines_enabled":false,"key":1406324528,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"The output should be:","key":-1711227943,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"Hello, World!","lines_enabled":false,"key":1876502203,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Congratulations, you have written and executed your first Python program.","key":-96933893,"type":-428893296}]},{"key":-1365434441,"name":"Python Version","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"Python Version","key":-230039322,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"To check the Python version of the editor, you can find it by importing the sys module:","key":646926444,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Check the Python version of the editor:","key":1071784449,"type":-428893296},{"$type":"Element.GENERAL_CODE_SCRIPT","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"import sys\r\n\r\nprint(sys.version)","text_title":"myfirstscript.py","lines_enabled":false,"key":-1637768721,"type":1254542888},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"You will learn more about importing modules in our \u003Ccolor=blue\u003E\u003Cu\u003EPython Modules\u003C/u\u003E\u003C/color\u003E chapter.","key":-927668842,"type":-428893296}]},{"key":812634071,"name":"The Python Command Line","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"The Python Command Line","key":946607282,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"To test a short amount of code in python sometimes it is quickest and easiest not to write the code in a file. This is made possible because Python can be run as a command line itself.","key":-223439473,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Type the following on the Windows, Mac or Linux command line:","key":840207839,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"C:\\Users\\Your Name\u003Epython","lines_enabled":false,"key":2075481943,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Or, if the \u0022python\u0022 command did not work, you can try \u0022py\u0022:","key":1860394318,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"C:\\Users\\Your Name\u003Epy","lines_enabled":false,"key":1306020917,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"From there you can write any python, including our hello world example from earlier in the tutorial:","key":-374775296,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"\u003Ccolor=#808080\u003EC:\\Users\\Your Name\u003Epython\r\nPython 3.6.4 (v3.6.4:d48eceb, Dec 19 2017, 06:04:45) [MSC v.1900 32 bit (Intel)] on win32\r\nType \u0022help\u0022, \u0022copyright\u0022, \u0022credits\u0022 or \u0022license\u0022 for more information.\u003C/color\u003E\n\u003E\u003E\u003E print(\u0022Hello, World!\u0022)","lines_enabled":false,"key":1415068353,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Whenever you are done in the python command line, you can simply type the following to quit the python command line interface:","key":814959773,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"exit()","lines_enabled":false,"key":-1291952252,"type":813157805}]}]},{"key":-1656097817,"name":"Python Syntax","pages":[{"key":-2094188948,"name":"Execute Python Syntax","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"Execute Python Syntax","key":1267144372,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"As we learned in the previous page, Python syntax can be executed by writing directly in the Command Line:","key":754454600,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"\u003E\u003E\u003E print(\u0022Hello, World!\u0022)\r\nHello, World!","lines_enabled":false,"key":404010159,"type":813157805},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Or by creating a python file on the server, using the .py file extension, and running it in the Command Line:","key":1583874335,"type":-428893296},{"$type":"Element.GENERAL_CODE_COMMAND","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"C:\\Users\\Your Name\u003Epython myfile.py","lines_enabled":false,"key":110146405,"type":813157805}]},{"key":1072034872,"name":"Python Indentation","elements":[{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":true,"italic_enabled":false,"underline_enabled":false,"font_size":32,"text_content":"Python Indentation","key":-816496961,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Indentation refers to the spaces at the beginning of a code line.","key":644642125,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Where in other programming languages the indentation in code is for readability only, the indentation in Python is very important.","key":1007780877,"type":-428893296},{"$type":"Element.GENERAL_TEXT","spacing":{"left":15,"right":15,"top":6,"bottom":6},"alignment_horizontal":0,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":18,"text_content":"Python uses indentation to indicate a block of code.","key":496818893,"type":-428893296},{"$type":"Element.GENERAL_CODE_SCRIPT","spacing":{"left":6,"right":6,"top":6,"bottom":6},"text_content":"if 5 \u003E 2:\r\n  print(\u0022Five is greater than two!\u0022)","text_title":"myscript.py","lines_enabled":false,"key":176235544,"type":1254542888}]}]}],"Quizzes_Menu":{"key":-1032731719,"name":"","elements":[{"$type":"Element.SYSTEM_QUIZ_MENU","title":"Python Quizzes","description":"Test your Python skills with  quizzes from all categories:","key":1631171637,"type":-238138132}]},"Quizzes":[{"key":-872382046,"name":"Get Started","pages":[{"key":-1148279201,"name":"","elements":[{"$type":"Element.CHALLENGE_MULTIPLE_CHOICE","submit_points":10,"question":{"alignment_horizontal":1,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":20,"text_content":"What is the correct file extension for Python files?","spacing":{"left":150,"right":150,"top":60,"bottom":15}},"options":{"shuffle_enabled":true,"option_correct_key":865476559,"list":[{"key":865476559,"text":".py"},{"key":1704492395,"text":".pt"},{"key":-1896719986,"text":".pp"}],"spacing":{"left":190,"right":190,"top":10,"bottom":10}},"key":848467468,"type":181698377}]},{"key":660524490,"name":"","elements":[{"$type":"Element.CHALLENGE_MULTIPLE_CHOICE","submit_points":10,"question":{"alignment_horizontal":1,"color_hex":"#000000","bold_enabled":false,"italic_enabled":false,"underline_enabled":false,"font_size":20,"text_content":"What is a correct command line syntax for checking if python is installed on your computer? (And also to check the Python version)","spacing":{"left":150,"right":150,"top":60,"bottom":15}},"options":{"shuffle_enabled":true,"option_correct_key":865476559,"list":[{"key":865476559,"t